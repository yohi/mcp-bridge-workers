# Purposefully mirrors successful chatgpt-mcp-tunnel OAuth runtime.
# Not a deployable Worker image. Published npm package pinned to known working version.
FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global --omit=dev mcp-remote@0.14.3 \
    && npm cache clean --force
RUN install -d -m 0700 -o node -g node /home/node/.mcp-auth \
    && install -d -m 0755 /etc/mcp-bridge
USER node
ENV MCP_REMOTE_CONFIG_DIR=/home/node/.mcp-auth
ENTRYPOINT ["mcp-remote-client"]
