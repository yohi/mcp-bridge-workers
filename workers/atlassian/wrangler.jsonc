{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "atlassian-rovo-mcp-bridge",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ATLASSIAN_UPSTREAM_MODE": "local_relay",
    "UPSTREAM_DENIAL_DIAGNOSTICS": "on"
  }
}
